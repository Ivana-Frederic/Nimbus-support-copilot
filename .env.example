# Copy to .env and adjust as needed. docker-compose.yml reads these.

# --- Ollama (local LLM serving) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_REQUEST_TIMEOUT_S=60

# --- RAG ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=/data/chroma
KB_DIR=/app/data/kb
TOP_K=4

# --- Intent classifier (transformer, optional fine-tuned weights) ---
INTENT_MODEL_DIR=/app/app/classifier/model
INTENT_BASE_MODEL=distilbert-base-uncased

# --- RL bandit ---
BANDIT_STATE_PATH=/data/bandit_state.json
BANDIT_ALPHA=1.0

# --- Storage ---
DB_PATH=/data/copilot.db

# --- API ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=info
